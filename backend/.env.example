# HabitForge Backend Environment Configuration

PORT=5000
JWT_SECRET=your_strong_random_secret_here_change_in_production

# CORS Frontend URL (required in production)
FRONTEND_URL=http://localhost:5173

# Local MongoDB URI
MONGODB_URI=mongodb://localhost:27017/habitforge

# OR MongoDB Atlas Cloud URI Example:
# MONGODB_URI=mongodb+srv://your_user:your_password@cluster.mongodb.net/habitforge?retryWrites=true&w=majority

# Set to 'production' to enforce stricter security (no MongoMemoryServer fallback, restricted CORS)
NODE_ENV=development
